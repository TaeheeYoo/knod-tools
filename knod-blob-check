#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Check a blob routine against what the kernel emits for it.

The kernel's JIT and the prebuilt routines have to agree instruction for
instruction, and nothing says so on its own: a change to one is not a build
error in the other, and a shader that is wrong in this way tends to read the
wrong memory rather than fault.

  knod-blob-check /sys/kernel/debug/dri/128/knod/bpf/insn build/knod-bpf-gfx10.bin

The prologue and the two halves of the epilogue are checked; those are the
routines the kernel emits somewhere a dump shows them whole.
"""

import argparse
import re
import struct
import subprocess
import sys

HDR = "<8I"
ENTRY = "<6I"
MAGIC = 0x4b4e4442
KIND_PROLOGUE = 9
KIND_EPILOGUE_PRE = 10
KIND_EPILOGUE_POST = 11

MCPU = {9: "gfx900", 10: "gfx1030", 11: "gfx1100"}

# Both sides are named by knod-disasm, so both come back in hex.  The tag the
# BPF dump carries says which BPF instruction a line came from and is not part
# of what is being compared.
INSN_RE = re.compile(r"^\s*([0-9a-fA-F]+):\s+(\S.*?)\s*(?:;.*)?$")


def read_blob(path):
    """-> (isa, wave, {kind: dwords})"""
    raw = open(path, "rb").read()
    magic, abi, isa, link, wave, n, eoff, _ = struct.unpack(HDR, raw[:32])
    if magic != MAGIC:
        sys.exit(f"{path}: not a knod blob")

    out = {}
    for i in range(n):
        at = eoff + i * struct.calcsize(ENTRY)
        kind, chunks, off, size, pairs, _ = struct.unpack(ENTRY, raw[at:at + struct.calcsize(ENTRY)])
        out.setdefault(kind, struct.unpack(f"<{size // 4}I", raw[off:off + size]))

    return isa, wave, out


def disassemble(dwords, mcpu, wave):
    """Run the dwords through knod-disasm and return its lines."""
    dump = [f"# mcpu {mcpu}", f"# wave {wave}", "# format block"]
    for i in range(0, len(dwords), 8):
        dump.append(" ".join(f"{d:08x}" for d in dwords[i:i + 8]))

    got = subprocess.run(["knod-disasm"], input="\n".join(dump) + "\n",
                         capture_output=True, text=True)
    if got.returncode != 0:
        sys.exit(f"knod-blob-check: knod-disasm failed:\n{got.stderr.strip()}")

    return parse(got.stdout, 16)


# knod-disasm works out where a branch lands and prints it after the
# instruction.  That is an absolute address, so it moves with the routine and
# is not part of what is being compared - the displacement is.
TARGET_RE = re.compile(r"\s+->\s+[0-9a-f]+$")


def parse(text, base):
    out = []
    for line in text.splitlines():
        got = INSN_RE.match(line)
        if got:
            out.append((int(got.group(1), base),
                        TARGET_RE.sub("", got.group(2))))
    return out


def kernel_section(path, marker):
    """The prologue section of a debugfs dump, up to where the JIT takes over.

    The dump holds dwords, so it goes through knod-disasm the same way the blob
    does - naming them two different ways would compare two different things.
    The prologue is laid out as a block either way, whether the JIT emitted it
    or spliced it in, so the two dumps read the same and this reads both.

    What follows the fixed part is the exec-save zeroing, one instruction per
    pair the program's control flow needs, so the comparison stops there.
    """
    got = subprocess.run(["knod-disasm", path], capture_output=True, text=True)
    if got.returncode != 0:
        sys.exit(f"knod-blob-check: knod-disasm failed on the dump:\n"
                 f"{got.stderr.strip()}")

    section = []
    inside = False
    for line in got.stdout.splitlines():
        if marker in line:
            inside = True
            continue
        if inside and line.startswith("==="):
            break
        if inside:
            section.append(line)

    if not section:
        sys.exit(f"knod-blob-check: the dump has no {marker} section")

    return parse("\n".join(section), 16)


def compare(what, want, got, quiet):
    """-> how many instructions differ.

    The offsets are shown but not compared: the kernel counts them in decimal
    and knod-disasm in hex, and instructions matching in sequence are the same
    length anyway.
    """
    if len(want) < len(got):
        print(f"{what}: the dump ends after {len(want)} instructions, "
              f"the routine has {len(got)}")
        return len(got) - len(want)

    bad = [(i, w, g) for i, (w, g) in enumerate(zip(want, got)) if w[1] != g[1]]
    for i, w, g in bad:
        print(f"{what} [{i}] kernel  {w[0]:5}  {w[1]}")
        print(f"{' ' * len(what)}       routine {g[0]:5}  {g[1]}")

    if not bad and not quiet:
        print(f"{what}: {len(got)} instructions match, "
              f"{len(want) - len(got)} more emitted by the JIT after them")
    return len(bad)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("dump", help="a debugfs insn file, or a copy of one")
    ap.add_argument("blob", help="the blob built for the same GPU")
    ap.add_argument("--quiet", action="store_true",
                    help="say nothing unless they differ")
    args = ap.parse_args()

    isa, wave, entries = read_blob(args.blob)
    if isa not in MCPU:
        sys.exit(f"{args.blob}: unknown isa {isa}")

    # The epilogue is in two pieces with a run the JIT emits between them, so
    # the second is lined up by its last instruction rather than by where the
    # section starts.
    checks = [
        ("prologue", KIND_PROLOGUE, "===[PROLOGUE]===", False),
        ("epilogue_pre", KIND_EPILOGUE_PRE, "===[EPILOG]===", False),
        ("epilogue_post", KIND_EPILOGUE_POST, "===[EPILOG]===", True),
    ]

    bad = 0
    for what, kind, marker, from_end in checks:
        if kind not in entries:
            print(f"{what}: not in this blob", file=sys.stderr)
            continue

        got = disassemble(entries[kind], MCPU[isa], wave)
        want = kernel_section(args.dump, marker)

        if from_end:
            at = next((i for i in range(len(want) - 1, -1, -1)
                       if want[i][1] == got[-1][1]), None)
            if at is None:
                print(f"{what}: the dump never reaches its last instruction")
                bad += 1
                continue
            want = want[max(0, at + 1 - len(got)):at + 1]

        bad += compare(what, want, got, args.quiet)

    if bad:
        sys.exit(f"knod-blob-check: {bad} differ")



if __name__ == "__main__":
    main()
